# Postgres connection string (Supabase "Transaction pooler" URL in production).
# Leave empty in local development: an embedded Postgres (PGlite) is used and stored in .data/
DATABASE_URL=
# Long random string used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET=change-me-in-production
# Public base URL of the site (used in emails and the father's link)
APP_URL=http://localhost:3000
# Resend (email). Leave empty to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Family Tracker <onboarding@resend.dev>"
# Protects the cron endpoints (Vercel sends it as a Bearer token)
CRON_SECRET=change-me
